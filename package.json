{
  "name": "omp-gui",
  "version": "0.1.3",
  "private": true,
  "description": "Oh My Pi 桌面客户端（RPC 驱动）",
  "author": "OMP Team",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "sync:collab": "node scripts/sync-collab.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "build:mac": "electron-vite build && electron-builder --mac --arm64 -p never",
    "pack:asar": "node scripts/pack-asar.mjs",
    "deploy:local": "node scripts/deploy-local.mjs"
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "cuelume": "^0.2.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "marked": "^18.0.14",
    "mermaid": "^12.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
